{
  "name": "looply-comp-lib",
  "version": "0.1.3",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "component library",
    "typescript",
    "npm"
  ],
  "description": "simple ui component",
  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:lib": "rollup -c src/rollup.config.mjs",
    "prepare": "npm run build:lib",
    "vercel-build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" \"*.md\"",
    "test": "jest"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@huggingface/inference": "^4.13.3",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.2",
    "@prisma/adapter-neon": "^7.2.0",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "@types/mdx": "^2.0.13",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "next": ">=14",
    "next-auth": "^5.0.0-beta.30",
    "next-mdx-remote": "^6.0.0",
    "next-themes": ">=0.4",
    "openai": "^6.9.1",
    "pg": "^8.16.3",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20.19.25",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.7.4",
    "prisma": "^7.1.0",
    "rollup": "^4.60.0",
    "rollup-plugin-postcss": "^4.0.2",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "next": ">=14",
    "next-themes": ">=0.4",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4"
  }
}
